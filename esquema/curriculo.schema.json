{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ateeducacion/curriculo_lomloe_canarias/esquema/curriculo.schema.json",
  "title": "Corpus del currículo LOMLOE de Canarias",
  "type": "object",
  "required": ["corpus", "nodos"],
  "additionalProperties": false,
  "properties": {
    "corpus": {
      "type": "object",
      "required": ["marco", "ambito", "version", "base", "normas"],
      "properties": {
        "marco": {"type": "string"},
        "ambito": {"type": "string"},
        "version": {"type": "string"},
        "generado": {"type": "string"},
        "base": {"type": "object"},
        "normas": {"type": "array"},
        "correcciones_aplicadas": {"type": "array", "items": {"type": "string"}}
      }
    },
    "nodos": {"type": "array", "items": {"$ref": "#/$defs/nodo"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^(etapa|curso|materia|ce|bc|crit|sb):[A-Za-z0-9.]+$"},
    "nodo": {
      "type": "object",
      "required": ["id", "tipo", "notation", "prefLabel"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "tipo": {"enum": ["Etapa", "Curso", "Materia", "CompetenciaEspecifica", "BloqueCompetencial",
                          "CriterioEvaluacion", "BloqueSaberes", "SaberBasico"]},
        "notation": {"type": "string", "minLength": 1},
        "prefLabel": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "scopeNote": {"type": "string", "minLength": 1},
        "broader": {"$ref": "#/$defs/id"},
        "agrupa": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "bloque": {"$ref": "#/$defs/id"},
        "descriptores": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]+[0-9.]*$"}},
        "cursos": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "materia": {"$ref": "#/$defs/id"},
        "curso": {"$ref": "#/$defs/id"},
        "etapa": {"$ref": "#/$defs/id"}
      },
      "allOf": [
        {"if": {"properties": {"tipo": {"const": "CriterioEvaluacion"}}},
         "then": {"required": ["broader", "bloque", "materia", "curso", "etapa"]}},
        {"if": {"properties": {"tipo": {"enum": ["SaberBasico", "BloqueSaberes", "BloqueCompetencial"]}}},
         "then": {"required": ["broader", "materia", "curso", "etapa"]}},
        {"if": {"properties": {"tipo": {"const": "CompetenciaEspecifica"}}},
         "then": {"required": ["broader", "materia", "etapa"]}}
      ]
    }
  }
}
